<?xml version="1.0"?>
<sdf version="1.9">
  <world name="practice">
    <physics name="default" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.85 0.9 0.95 1</background><shadows>false</shadows></scene>
    <light name="sun" type="directional">
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -1</direction><cast_shadows>false</cast_shadows>
      <attenuation><range>100</range><constant>1</constant><linear>0</linear><quadratic>0</quadratic></attenuation>
    </light>
    <model name="floor">
      <static>true</static>
      <link name="floor">
        <collision name="floor"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="floor">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Original simple robot; no external model or Fuel download is needed. -->
    <model name="practice_robot">
      <pose>0 0 0.01 0 0 0</pose>
      <link name="base_link">
        <pose>0 0 0.18 0 0 0</pose>
        <inertial><mass>2</mass><inertia><ixx>0.024</ixx><iyy>0.046</iyy><izz>0.065</izz></inertia></inertial>
        <collision name="body"><geometry><box><size>0.5 0.34 0.16</size></box></geometry></collision>
        <visual name="body">
          <geometry><box><size>0.5 0.34 0.16</size></box></geometry>
          <material><ambient>0.1 0.4 0.8 1</ambient><diffuse>0.1 0.4 0.8 1</diffuse></material>
        </visual>
        <visual name="front">
          <pose>0.251 0 0 0 0 0</pose>
          <geometry><box><size>0.01 0.25 0.08</size></box></geometry>
          <material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material>
        </visual>
        <sensor name="attitude" type="imu">
          <topic>/step2/imu</topic><update_rate>50</update_rate><always_on>true</always_on>
        </sensor>
        <sensor name="lidar" type="gpu_lidar">
          <pose>0.12 0 0.13 0 0 0</pose>
          <topic>/scan</topic><update_rate>10</update_rate><always_on>true</always_on>
          <lidar>
            <scan><horizontal><samples>180</samples><resolution>1</resolution><min_angle>-3.14159265</min_angle><max_angle>3.14159265</max_angle></horizontal></scan>
            <range><min>0.05</min><max>8</max><resolution>0.01</resolution></range>
          </lidar>
        </sensor>
      </link>
      <link name="left_wheel">
        <pose>0 0.22 0.10 -1.570796327 0 0</pose>
        <inertial><mass>0.15</mass><inertia><ixx>0.0004</ixx><iyy>0.0004</iyy><izz>0.00075</izz></inertia></inertial>
        <collision name="wheel"><geometry><cylinder><radius>0.1</radius><length>0.06</length></cylinder></geometry></collision>
        <visual name="wheel">
          <geometry><cylinder><radius>0.1</radius><length>0.06</length></cylinder></geometry>
          <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
        </visual>
      </link>
      <link name="right_wheel">
        <pose>0 -0.22 0.10 -1.570796327 0 0</pose>
        <inertial><mass>0.15</mass><inertia><ixx>0.0004</ixx><iyy>0.0004</iyy><izz>0.00075</izz></inertia></inertial>
        <collision name="wheel"><geometry><cylinder><radius>0.1</radius><length>0.06</length></cylinder></geometry></collision>
        <visual name="wheel">
          <geometry><cylinder><radius>0.1</radius><length>0.06</length></cylinder></geometry>
          <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
        </visual>
      </link>
      <link name="caster">
        <pose>-0.20 0 0.05 0 0 0</pose>
        <inertial><mass>0.05</mass><inertia><ixx>0.00005</ixx><iyy>0.00005</iyy><izz>0.00005</izz></inertia></inertial>
        <collision name="caster">
          <geometry><sphere><radius>0.05</radius></sphere></geometry>
          <surface><friction><ode><mu>0.001</mu><mu2>0.001</mu2></ode></friction></surface>
        </collision>
        <visual name="caster"><geometry><sphere><radius>0.05</radius></sphere></geometry></visual>
      </link>
      <!-- Front support prevents nose-down tipping during acceleration. -->
      <link name="front_caster">
        <pose>0.20 0 0.05 0 0 0</pose>
        <inertial><mass>0.05</mass><inertia><ixx>0.00005</ixx><iyy>0.00005</iyy><izz>0.00005</izz></inertia></inertial>
        <collision name="front_caster">
          <geometry><sphere><radius>0.05</radius></sphere></geometry>
          <surface><friction><ode><mu>0.001</mu><mu2>0.001</mu2></ode></friction></surface>
        </collision>
        <visual name="front_caster"><geometry><sphere><radius>0.05</radius></sphere></geometry></visual>
        <sensor name="support_contact" type="contact">
          <always_on>true</always_on><update_rate>50</update_rate>
          <topic>/step2/support_contacts</topic>
          <contact><collision>front_caster</collision><topic>/step2/support_contacts</topic></contact>
        </sensor>
      </link>
      <joint name="front_caster_joint" type="fixed"><parent>base_link</parent><child>front_caster</child></joint>
      <joint name="left_wheel_joint" type="revolute">
        <parent>base_link</parent><child>left_wheel</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <joint name="right_wheel_joint" type="revolute">
        <parent>base_link</parent><child>right_wheel</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <joint name="caster_joint" type="fixed"><parent>base_link</parent><child>caster</child></joint>
      <!-- Evaluation only: world-to-model pose, independent of wheel odometry. -->
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_model_pose>true</publish_model_pose>
        <publish_link_pose>false</publish_link_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <publish_sensor_pose>false</publish_sensor_pose>
        <publish_nested_model_pose>false</publish_nested_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <static_publisher>false</static_publisher>
        <update_frequency>20</update_frequency>
        <topic>/step2/ground_truth</topic>
      </plugin>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.44</wheel_separation><wheel_radius>0.10</wheel_radius>
        <topic>/cmd_vel</topic><odom_topic>/odom</odom_topic>
        <frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id>
        <odom_publish_frequency>20</odom_publish_frequency>
        <max_linear_velocity>0.5</max_linear_velocity><min_linear_velocity>-0.5</min_linear_velocity>
        <max_angular_velocity>1.5</max_angular_velocity><min_angular_velocity>-1.5</min_angular_velocity>
        <max_linear_acceleration>0.3</max_linear_acceleration><min_linear_acceleration>-0.5</min_linear_acceleration>
      </plugin>
    </model>
    <model name="obstacle">
      <static>true</static><pose>1.5 0.5 0.4 0 0 0</pose>
      <link name="box">
        <sensor name="obstacle_contact" type="contact">
          <always_on>true</always_on><update_rate>100</update_rate>
          <topic>/step2/obstacle_contacts</topic>
          <contact><collision>box</collision><topic>/step2/obstacle_contacts</topic></contact>
        </sensor>
        <collision name="box"><geometry><box><size>0.5 0.7 0.8</size></box></geometry></collision>
        <visual name="box"><geometry><box><size>0.5 0.7 0.8</size></box></geometry><material><ambient>0.8 0.3 0.1 1</ambient><diffuse>0.8 0.3 0.1 1</diffuse></material></visual>
      </link>
    </model>
    <model name="goal_marker">
      <static>true</static><pose>3 1 0.005 0 0 0</pose>
      <link name="marker">
        <visual name="marker"><geometry><cylinder><radius>0.4</radius><length>0.01</length></cylinder></geometry><material><ambient>0.1 0.7 0.2 1</ambient><diffuse>0.1 0.7 0.2 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
