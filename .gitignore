# Local credentials and secrets must never be uploaded.
.env
.env.*
*.env
*.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.kdbx
.netrc
.npmrc
.pypirc
secrets/
credentials/
credentials.json
.ssh/
.aws/
.azure/
.gcp/
id_rsa
id_ed25519
**/service-account*.json

# Local backups must never be uploaded.
*.bak
*.orig
*~

# Generated run artifacts and ROS recordings must never be uploaded.
outputs/*
!outputs/.gitkeep
work/
*.log
*.bag
*.db3
*.mcap

# Local environments, caches, and downloaded workshop data.
.venv/
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
**/.ipynb_checkpoints/
**/.cache/
.DS_Store
Thumbs.db
workshop/data/
workshop/artifacts/
workshop/.venv/
workshop/.uv-cache/

