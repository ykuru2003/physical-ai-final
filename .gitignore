.npmrc
.pypirc
secrets/
credentials/
credentials.json
.ssh/
.aws/
.azure/
.gcp/
id_rsa
id_ed25519
**/service-account*.json

# Local backups, environments and generated workshop files.
*.bak
*.orig
*~
.venv/
.uv-cache/
**/__pycache__/
